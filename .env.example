# Server-only backend configuration. Never prefix secrets with VITE_.
AI_API_BASE=http://localhost:20128/v1
AI_API_KEY=replace-with-server-secret
AI_MODEL=my9
PORT=5001
MAX_CONTENT_LENGTH=104857600
CORS_ORIGINS=http://localhost:5173

# Public frontend build-time configuration. Browser-visible by design.
VITE_BACKEND_URL=http://localhost:5001
